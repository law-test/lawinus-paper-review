{"page":43,"targets":[{"kind":"law","label":"제31조","title":"민사집행법 제31조","url":"https://www.law.go.kr/LSW/lsSideInfoP.do?docCls=jo&joBrNo=00&joNo=0031&lsiSeq=268837&urlMode=lsScJoRltInfoR","status":"current","articleText":"제31조(승계집행문) ①집행문은 판결에 표시된 채권자의 승계인을 위하여 내어 주거나 판결에 표시된 채무자의 승계인에 대한 집행을 위하여 내어 줄 수 있다. 다만, 그 승계가 법원에 명백한 사실이거나, 증명서로 승계를 증명한 때에 한한다.\n\n②제1항의 승계가 법원에 명백한 사실인 때에는 이를 집행문에 적어야 한다.\n\n","noteNumber":83,"line":12,"x":0.2293551,"y":0.5602026,"w":0.0526167,"h":0.0123538},{"kind":"case","label":"2011다49523","title":"판례 2011다49523","url":"https://www.law.go.kr/LSW/precSc.do?menuId=7&query=2011%EB%8B%A449523","noteNumber":85,"line":18,"x":0.3542675,"y":0.7054831,"w":0.1065279,"h":0.0123538},{"kind":"note","number":83,"targetPage":43,"label":"83)","title":"각주 83","x":0.7466834,"y":0.2202867,"w":0.0213949,"h":0.0113598},{"kind":"note","number":84,"targetPage":43,"label":"84)","title":"각주 84","x":0.4487079,"y":0.310881,"w":0.0211638,"h":0.0113598},{"kind":"note","number":85,"targetPage":43,"label":"85)","title":"각주 85","x":0.5815292,"y":0.3713322,"w":0.0213949,"h":0.0113598},{"kind":"note","number":86,"targetPage":43,"label":"86)","title":"각주 86","x":0.1351474,"y":0.4620913,"w":0.0211638,"h":0.0113598},{"kind":"note","number":83,"targetPage":43,"label":"83)","title":"각주 83 본문 위치","line":12,"x":0.1097927,"y":0.5600708,"w":0.0189506,"h":0.0092242},{"kind":"note","number":84,"targetPage":43,"label":"84)","title":"각주 84 본문 위치","line":15,"x":0.1097927,"y":0.6327111,"w":0.0189506,"h":0.0092242},{"kind":"note","number":85,"targetPage":43,"label":"85)","title":"각주 85 본문 위치","line":18,"x":0.1097927,"y":0.705516,"w":0.0189506,"h":0.0092241},{"kind":"note","number":86,"targetPage":43,"label":"86)","title":"각주 86 본문 위치","line":21,"x":0.1097927,"y":0.7781562,"w":0.0189506,"h":0.0092241}],"lines":[]}